# Free tier only, no paid keys.

# https://console.groq.com/keys — primary LLM, generous free rate limits
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/apikey — fallback LLM if Groq errors/rate-limits
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# https://app.pinecone.io — free Starter plan, create an index WITH an
# integrated embedding model attached (e.g. multilingual-e5-large) so no
# separate embeddings API is needed
PINECONE_API_KEY=
PINECONE_INDEX=nyayasetu-regs

# https://app.supabase.com — free tier
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
